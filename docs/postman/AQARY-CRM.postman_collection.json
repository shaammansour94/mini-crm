  "item": [
    {
      "name": "01 — Admin authentication",
      "description": "ابدأ هنا. يعمل الاختبار باستخدام Cookies دون Bearer Token.",
      "item": [
        {
          "name": "Login — Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "ينشئ جلسة HttpOnly. Postman يحفظ Cookie ويرسلها تلقائيًا؛ اترك Cookie Jar مفعّلًا. تسجيل الدخول بحساب آخر يبدّل الجلسة الحالية.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
                  "if (pm.response.code === 200) {",
                  "  pm.test(\"Correct role\", function () { pm.expect(pm.response.json().data.role).to.eql(\"ADMIN\"); });",
                  "  pm.test(\"Session cookie set\", function () { pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"aqary_session=\"); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Form schema",
      "description": "قراءة النموذج متاحة للدورين، والحفظ للـAdmin فقط. طلب القراءة يلتقط تعريف النموذج الحالي تلقائيًا.",
      "item": [
        {
          "name": "Get saved form schema",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/form-schema",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "form-schema"
              ]
            },
            "description": "يحفظ fields في متغير formFields. الأنواع المدعومة: text, email, number, dropdown, date, checkbox. خيارات Status ثابتة: New, Contacted, Qualified, Lost."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Saved field definition returned\", function () { pm.expect(body.data.fields).to.be.an(\"array\"); });",
                  "  pm.collectionVariables.set(\"formFields\", JSON.stringify(body.data.fields));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Save form schema — Admin",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/form-schema",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "form-schema"
              ]
            },
            "description": "يرسل التعريف الموجود في formFields. نفّذ GET أولًا؛ الإرسال دون تعديل يعيد حفظ نفس التعريف. لتجربة التعديل، عدّل JSON داخل متغير formFields قبل الإرسال. إزالة حقل من المصفوفة تغيّر النموذج النشط وتُبقي قيمه القديمة. لا تغيّر IDs أو أنواع الحقول الأساسية. احفظ نسخة من التعريف قبل تجربة حذفه.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {{formFields}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fields = pm.collectionVariables.get(\"formFields\");",
                  "if (!fields || !Array.isArray(JSON.parse(fields))) {",
                  "  throw new Error(\"Run Get saved form schema first. Then edit formFields if you want to change the definition.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Saved field definition returned\", function () { pm.expect(body.data.fields).to.be.an(\"array\"); });",
                  "  pm.collectionVariables.set(\"formFields\", JSON.stringify(body.data.fields));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Leads",
      "description": "إنشاء عميل يلتقط leadId وleadValues تلقائيًا. الطلبات تعتمد على النموذج المحفوظ؛ إذا أضفت حقولًا مطلوبة، أضف قيمها إلى body باستخدام IDs الفعلية.",
      "item": [
        {
          "name": "List / search / filter / paginate",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leads?search={{search}}&page={{page}}&pageSize={{pageSize}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leads"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "{{search}}",
                  "description": "كلمة البحث بالاسم أو البريد",
                  "disabled": false
                },
                {
                  "key": "status",
                  "value": "{{status}}",
                  "description": "New / Contacted / Qualified / Lost؛ عطّل البارامتر لعرض الكل",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "{{page}}",
                  "description": "رقم الصفحة يبدأ من 1",
                  "disabled": false
                },
                {
                  "key": "pageSize",
                  "value": "{{pageSize}}",
                  "description": "عدد النتائج، بحد أقصى 100",
                  "disabled": false
                }
              ]
            },
            "description": "البحث بالاسم أو البريد مع فلتر الحالة قبل Pagination. ألغِ disabled عن status لتطبيقه. لا تستخدم status=All؛ احذف البارامتر لعرض جميع الحالات. pageSize من 1 إلى 100."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"List and matching total returned\", function () {",
                  "    pm.expect(body.data).to.be.an(\"array\");",
                  "    pm.expect(body.total).to.be.a(\"number\");",
                  "    pm.expect(body.page).to.be.a(\"number\");",
                  "    pm.expect(body.pageSize).to.be.a(\"number\");",
                  "    pm.expect(body.data.length).to.be.at.most(body.pageSize);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leads"
              ]
            },
            "description": "ينشئ سجلًا حقيقيًا في قاعدة السيرفر المحدد. المثال يناسب النموذج الأولي. الحقول الإضافية يجب أن تستخدم IDs من GET form-schema. التاريخ بصيغة YYYY-MM-DD ضمن 1970–9999. Checkbox بقيمة boolean. لا توجد API لحذف العملاء في المشروع.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": {\n    \"name\": \"{{leadName}}\",\n    \"email\": \"{{leadEmail}}\",\n    \"status\": \"New\",\n    \"budget\": 850000,\n    \"preferred_location\": \"Dubai Marina\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const lead = pm.response.json().data;",
                  "  pm.test(\"Lead ID returned\", function () { pm.expect(lead.id).to.be.a(\"string\"); });",
                  "  pm.collectionVariables.set(\"leadId\", lead.id);",
                  "  pm.collectionVariables.set(\"leadValues\", JSON.stringify(lead.values));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get lead by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leads/{{leadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leads",
                "{{leadId}}"
              ]
            },
            "description": "يعرض البيانات المحفوظة بما فيها values، ويلتقطها لاستخدامها في التعديل. يمكنك وضع ID سجل موجود يدويًا في المتغير leadId."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"leadId\")) {",
                  "  throw new Error(\"Run Create lead first, or set the leadId collection variable to an existing lead ID.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const lead = pm.response.json().data;",
                  "  pm.test(\"Lead ID returned\", function () { pm.expect(lead.id).to.be.a(\"string\"); });",
                  "  pm.collectionVariables.set(\"leadId\", lead.id);",
                  "  pm.collectionVariables.set(\"leadValues\", JSON.stringify(lead.values));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update lead — Lost with loss reason",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leads/{{leadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "leads",
                "{{leadId}}"
              ]
            },
            "description": "يستخدم leadValues من آخر إنشاء/قراءة، ثم يغيّر الاسم والحالة إلى Lost ويضيف Loss reason. يحافظ المثال على الحقول المخصصة الموجودة. إذا اختلف ID حقل السبب في نموذجك، عدّل السكربت. التحقق يتم مقابل النموذج المحفوظ.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": {{updatedLeadValues}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"leadId\")) {",
                  "  throw new Error(\"Run Create lead first, or set the leadId collection variable to an existing lead ID.\");",
                  "}",
                  "const raw = pm.collectionVariables.get(\"leadValues\");",
                  "if (!raw) throw new Error(\"Run Create lead or Get lead by ID first.\");",
                  "const values = JSON.parse(raw);",
                  "values.name = pm.collectionVariables.get(\"leadName\") + \" — updated\";",
                  "values.status = \"Lost\";",
                  "values.loss_reason = \"Budget no longer available\";",
                  "pm.variables.set(\"updatedLeadValues\", JSON.stringify(values));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const lead = pm.response.json().data;",
                  "  pm.test(\"Lead ID returned\", function () { pm.expect(lead.id).to.be.a(\"string\"); });",
                  "  pm.collectionVariables.set(\"leadId\", lead.id);",
                  "  pm.collectionVariables.set(\"leadValues\", JSON.stringify(lead.values));",
                  "}"
                ]
              }
            }
          ]
        },
