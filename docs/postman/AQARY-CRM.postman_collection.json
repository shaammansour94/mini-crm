                "type": "text/javascript",
                "exec": [
                  "const fields = pm.collectionVariables.get(\"formFields\");",
                  "if (!fields || !Array.isArray(JSON.parse(fields))) {",
                  "  throw new Error(\"Run Get saved form schema first. Then edit formFields if you want to change the definition.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Permission error message\", function () { pm.expect(pm.response.json().message).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        }
      ]
